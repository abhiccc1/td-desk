# Infrastructure
REDIS_URL=redis://redis:6379/0
TIMESCALEDB_URL=postgresql+asyncpg://trader:trader@timescaledb:5432/tradingdb
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=tradingdb

# Application
LOG_LEVEL=info
ENVIRONMENT=development

# Market Data - Broker Credentials
NSE_WS_URL=
MCX_WS_URL=
# MCX commodity options (CRUDEOIL, NATURALGAS, GOLD + minis). Hidden from
# /underlyings and not subscribed until true.
MCX_ENABLED=false
# Allow live (non-paper) MCX order placement. Qty is sent in units (lots × lot size).
MCX_LIVE_ORDERS_ENABLED=false
BROKER_API_KEY=
BROKER_API_SECRET=

# Quant Service
RISK_FREE_RATE=0.065

# Auth
JWT_SECRET=local-dev-secret-change-in-prod
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Kotak Neo Broker
#
# Multiple accounts: a JSON array of profiles. The login screen shows a picker
# built from this; consumer keys stay server-side and never reach the client.
# Must be one line (no newlines inside the value).
# KOTAK_ACCOUNTS=[{"id":"primary","label":"Primary","consumer_key":"KEY1","mobile":"+919999999999","ucc":"ABCD1"},{"id":"hedge","label":"Hedge book","consumer_key":"KEY2","mobile":"+918888888888","ucc":"WXYZ9"}]
KOTAK_ACCOUNTS=
#
# Single-account fallback, used only when KOTAK_ACCOUNTS is empty. The mobile
# number and UCC then come from the app's Settings screen.
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_ENVIRONMENT=prod

# Frontend (NEXT_PUBLIC_ prefix for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream
