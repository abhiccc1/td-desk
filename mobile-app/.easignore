# Files excluded from the tarball uploaded to EAS Build.
#
# This project sits inside the td-desk git repo but is untracked there, so
# builds run with EAS_NO_VCS=1 and upload the working tree directly. That makes
# this file the only thing standing between the working tree and EAS's servers
# — without it the signing keystores below would be uploaded on every build.

# Signing keystores. EAS holds the production credentials server-side; the
# local copies are backups and must never be uploaded.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Installed by EAS on the build worker from package-lock.json.
node_modules/

# Native projects are regenerated by prebuild from app.json. Shipping the local
# copies would silently override the config plugins declared there.
android/
ios/

# Local caches and build output.
.expo/
dist/
web-build/
*.apk
*.aab
*.log
.DS_Store
