# Signing keystores. These are the production Android signing keys — EAS holds
# the authoritative copies server-side and the local files are backups. They
# must never enter git history, which is effectively impossible to undo.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Credentials and local config.
.env
.env.*
google-services.json
GoogleService-Info.plist

# Dependencies — restored from package-lock.json.
node_modules/

# Native projects, regenerated by `npx expo prebuild` from app.json. Ignored
# because nothing here is hand-written: the current trees are vanilla prebuild
# output (default MainActivity/MainApplication, manifest matching app.json).
# If native code ever is edited by hand, un-ignore the platform directory in
# the same commit that adds it, or the change will silently vanish.
android/
ios/

# Build output and caches.
.expo/
dist/
web-build/
*.apk
*.aab
*.aab.idsig
*.tsbuildinfo

# Editor and OS noise.
.DS_Store
*.log
npm-debug.*
yarn-error.*

